<?xml version="1.0" encoding="UTF-8"?>
<!-- Shaped like a Plex Media Server's /library/sections, with every
     value invented. What it keeps is the structure: Directory rather
     than Section, key joining to the sharing list, and Location as a
     repeatable CHILD element rather than an attribute — a library
     pointing at two folders is the case a single-path reading breaks
     on. -->
<MediaContainer size="3" allowSync="0" title1="Plex Library">
  <Directory allowSync="1" filters="1" refreshing="0" key="1" type="movie"
             title="Films" agent="tv.plex.agents.movie" scanner="Plex Movie"
             language="en-US" uuid="00000000-0000-4000-8000-000000000001"
             updatedAt="1700000000" createdAt="1690000000" content="1"
             directory="1" hidden="0">
    <Location id="1" path="/srv/library/films"/>
  </Directory>
  <Directory allowSync="1" filters="1" refreshing="0" key="2" type="show"
             title="Series" agent="tv.plex.agents.series" scanner="Plex TV Series"
             language="en-US" uuid="00000000-0000-4000-8000-000000000002"
             updatedAt="1700000000" createdAt="1690000000" content="1"
             directory="1" hidden="0">
    <Location id="2" path="/srv/library/series"/>
  </Directory>
  <!-- one library, two folders -->
  <Directory allowSync="1" filters="1" refreshing="0" key="3" type="movie"
             title="Documentaries" agent="tv.plex.agents.movie" scanner="Plex Movie"
             language="en-US" uuid="00000000-0000-4000-8000-000000000003"
             updatedAt="1700000000" createdAt="1690000000" content="1"
             directory="1" hidden="1">
    <Location id="3" path="/srv/library/docs"/>
    <Location id="4" path="/mnt/overflow/docs"/>
  </Directory>
</MediaContainer>
