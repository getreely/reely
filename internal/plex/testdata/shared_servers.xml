<?xml version="1.0" encoding="UTF-8"?>
<!-- Shaped like plex.tv's /api/servers/{machineId}/shared_servers, with
     every value invented. What it preserves from a real response is the
     structure and the flag combinations, which are the parts that decide
     anything: allLibraries set alongside a full Section list, a partial
     share whose sections carry their own flags, and an invitation that
     was never accepted. -->
<MediaContainer friendlyName="myPlex" identifier="com.plexapp.plugins.myplex" size="4">
  <!-- a standing grant: sections that don't exist yet are shared too,
       and the Section list is present regardless -->
  <SharedServer id="1001" username="ana" email="ana@example.com" userID="500001"
                accessToken="redacted" owned="1" allLibraries="1"
                invitedAt="1700000000" acceptedAt="1700000060" allowSync="0"
                filterAll="" filterMovies="" filterTelevision="">
    <Section id="9001" key="1" title="Films" type="movie" shared="1"/>
    <Section id="9002" key="2" title="Series" type="show" shared="1"/>
  </SharedServer>
  <!-- a partial share: every section is listed, and shared decides -->
  <SharedServer id="1002" username="ben" email="ben@example.com" userID="500002"
                accessToken="redacted" owned="1" allLibraries="0"
                invitedAt="1700000000" acceptedAt="1700000500" allowSync="0"
                filterAll="" filterMovies="" filterTelevision="">
    <Section id="9001" key="1" title="Films" type="movie" shared="1"/>
    <Section id="9002" key="2" title="Series" type="show" shared="0"/>
  </SharedServer>
  <!-- invited, never accepted: listed here but reaches nothing -->
  <SharedServer id="1003" username="cass" email="cass@example.com" userID="500003"
                accessToken="redacted" owned="1" allLibraries="1"
                invitedAt="1700000000" acceptedAt="" allowSync="0"
                filterAll="" filterMovies="" filterTelevision="">
    <Section id="9001" key="1" title="Films" type="movie" shared="1"/>
    <Section id="9002" key="2" title="Series" type="show" shared="1"/>
  </SharedServer>
  <!-- nothing to match a sign-in against -->
  <SharedServer id="1004" username="" email="" userID="0"
                owned="1" allLibraries="1" invitedAt="1700000000" acceptedAt="1700000060">
    <Section id="9001" key="1" title="Films" type="movie" shared="1"/>
  </SharedServer>
</MediaContainer>
